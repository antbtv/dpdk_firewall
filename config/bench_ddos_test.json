{
  "version": 1,
  "mode": "bridge",
  "ports": {
    "wan": "enP1p1s0",
    "lan": "builtin"
  },
  "default_policy": "accept",
  "hugepages": {
    "size_mb": 1024
  },
  "ddos": {
    "enabled": true,
    "window_ms": 100,
    "syn_pps_threshold": 100,
    "udp_pps_threshold": 500,
    "icmp_pps_threshold": 200,
    "block_duration_s": 30
  },
  "logging": {
    "level": "info",
    "file": "/var/log/dpdk_firewall.log"
  },
  "rules": []
}
